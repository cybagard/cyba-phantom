{
  "name": "cyba-phantom (Go 1.27.3, matching CI)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/src",
  "workspaceMount": "source=${localWorkspaceFolder},target=/src,type=bind",
  "runArgs": ["--network=none"],
  "init": true,
  "mounts": [
    "source=cyba-phantom-modules,target=/go/pkg/mod,type=volume,readonly"
  ]
}
